# Salin menjadi .env untuk pengembangan lokal.
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=

# Kosong menggunakan SQLite lokal. Compose menyediakan PostgreSQL lokal jika kosong.
DATABASE_URL=
DATABASE_TRANSACTION_POOLING=False

# Wajib untuk PostgreSQL Docker Compose lokal; ganti dengan password lokal Anda.
POSTGRES_PASSWORD=bintang123

# Opsional untuk object storage S3-compatible (misalnya Supabase Storage).
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=
AWS_S3_CUSTOM_DOMAIN=
AWS_QUERYSTRING_AUTH=False
